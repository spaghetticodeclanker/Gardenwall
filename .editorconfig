# Editor settings for this repository (https://editorconfig.org).
# Line endings are left to Git (.gitattributes) and each file's existing
# style: some documents use CRLF, most code uses LF.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,tsx,js,mjs,cjs,json,css,html,yml,yaml}]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
