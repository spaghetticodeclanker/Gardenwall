{
  "name": "gardenwall-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "app:bundle": "node ../scripts/bundle.mjs",
    "app:dev": "cargo build -p gardenwall-relay -p gardenwall-parse -p gardenwall-binary -p gardenwall-js -p gardenwall-fetch && cargo build -p gardenwall-agent --bin gardenwall-gitscan && cd ../crates/gardenwall-app && tauri dev"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "lucide-react": "1.69.0",
    "marked": "18.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
