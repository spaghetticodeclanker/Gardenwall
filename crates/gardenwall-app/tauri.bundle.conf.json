{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "customLanguageFiles": { "English": "nsis/English.nsh" },
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "resources": {
      "../../LICENSE": "LICENSE.txt",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md"
    },
    "externalBin": [
      "binaries/gardenwall-relay",
      "binaries/gardenwall-parse",
      "binaries/gardenwall-binary",
      "binaries/gardenwall-js",
      "binaries/gardenwall-fetch",
      "binaries/gardenwall-gitscan"
    ]
  }
}
